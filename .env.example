# Model provider keys. models.json names the endpoints and refers to these as "$AZURE_FOUNDRY_API_KEY"
# and so on; a key can also live in your user environment instead of here.
AZURE_FOUNDRY_API_KEY=

# Optional: xAI (CUABOT_MODEL=xai/<model>). Sign in with `node src/login.ts xai` or set a key.
XAI_API_KEY=

# Optional: OpenAI (CUABOT_MODEL=openai/<model>). Sign in with your ChatGPT plan with `node src/login.ts openai`
# or set a key.
OPENAI_API_KEY=

# Your email address, where the bot sends its reports (through Gmail in Executor).
OWNER_EMAIL=

# Optional. Cua Space id. Defaults to the first space in ~/.cua/spaces.json.
CUA_SPACE_ID=

# Optional. The cua CLI whose `mcp` server gives the bot every Cua Spaces tool. Defaults to the Cua Spaces
# app's bundled cua.exe on Windows, else `cua` on PATH.
CUA_MCP_COMMAND=

# Optional. "provider/model", overriding "default" in models.json. Settings > Model in the web app changes this.
CUABOT_MODEL=

# Optional. Reasoning effort: off, minimal, low, medium, high, xhigh, or max. Defaults to medium.
# Settings > Model in the web app changes this.
CUABOT_REASONING=

# Optional. HTTP port. Defaults to 43142.
CUABOT_PORT=

# Optional. Comma-separated host names of HTTPS proxies in front of the web app, e.g. your Tailscale Serve name
# <machine>.<tailnet>.ts.net. Every device that can reach the proxy can use the bot, with no login.
CUABOT_ALLOWED_HOSTS=

# Gmail, Google Calendar, and other accounts, through Executor Cloud (executor.sh).
# The MCP URL from Executor's Connect card, e.g. https://executor.sh/<org>/mcp
EXECUTOR_MCP_URL=
# An API key from Executor's "API keys" page.
EXECUTOR_API_KEY=
