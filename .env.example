# Model provider keys. models.json names the endpoints and refers to these as "$AZURE_FOUNDRY_API_KEY"
# and so on; a key can also live in your user environment instead of here.
AZURE_FOUNDRY_API_KEY=

# Optional: xAI (CUABOT_MODEL=xai/<model>). Sign in with `node src/login.ts` or set a key.
XAI_API_KEY=

# Your email address, where the bot sends its reports (through Gmail in Executor).
OWNER_EMAIL=

# Optional. Cua Space id. Defaults to the first space in ~/.cua/spaces.json.
CUA_SPACE_ID=

# Optional. "provider/model", overriding "default" in models.json.
CUABOT_MODEL=

# Optional. HTTP port. Defaults to 43142.
CUABOT_PORT=

# Gmail, Google Calendar, and other accounts, through Executor Cloud (executor.sh).
# The MCP URL from Executor's Connect card, e.g. https://executor.sh/<org>/mcp
EXECUTOR_MCP_URL=
# An API key from Executor's "API keys" page.
EXECUTOR_API_KEY=
