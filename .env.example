# The model: a deployment on your Azure AI Foundry resource, over its OpenAI-compatible endpoint.
# Base URL like https://<resource>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_BASE_URL=
# The resource key. Can live in your user environment instead of here.
AZURE_FOUNDRY_API_KEY=

# Optional: xAI instead of Azure (GROKBOT_PROVIDER=xai). Sign in with `node src/login.ts` or set a key.
XAI_API_KEY=

# Address that receives proactive email. The bot mails this address only.
OWNER_EMAIL=

# Gmail address used as the SMTP login.
SMTP_USER=

# Gmail app password, not the normal account password.
SMTP_PASS=

# Optional. Cua Space id. Defaults to the first space in ~/.cua/spaces.json.
CUA_SPACE_ID=

# Optional. Provider and model. Default azure-foundry and grok-4.6; see src/models.ts for the deployments.
GROKBOT_PROVIDER=
GROKBOT_MODEL=

# Optional. HTTP port. Defaults to 43142.
GROKBOT_PORT=

# Gmail, Google Calendar, and other accounts, through Executor Cloud (executor.sh).
# The MCP URL from Executor's Connect card, e.g. https://executor.sh/<org>/mcp
EXECUTOR_MCP_URL=
# An API key from Executor's "API keys" page.
EXECUTOR_API_KEY=
